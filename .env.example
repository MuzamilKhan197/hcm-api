PORT=8000
MONGODB_URI=mongodb://127.0.0.1:27017/hcm_lite?replicaSet=rs0
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
CLIENT_URL=http://localhost:5173
NODE_ENV=development
# Optional: demo is explicitly enabled with npm run dev:demo, never in production.
# Optional: without a key, the assistant uses local workspace insights.
# OPENAI_API_KEY=your-secret-key
OPENAI_MODEL=gpt-4o-mini
